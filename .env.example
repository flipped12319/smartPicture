# ============================================================
# docker-compose 的环境变量模板
# ------------------------------------------------------------
# 用法：复制本文件为 .env（.env 已被 .gitignore 忽略，不会入库）
#     copy .env.example .env
#
# 不填也能跑：下面每一项在 docker-compose.yml 里都有占位默认值，
# 但默认值只适合本机试验，不要用于任何对外环境。
# ============================================================

# 容器 MySQL 的 root 密码（仅在启用 --profile mysql 时生效）
MYSQL_ROOT_PASSWORD=change-me-dev-only

# RabbitMQ 的开发凭据（管理台 http://localhost:15672 用同一组）
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=change-me-dev-only
