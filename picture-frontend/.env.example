# ============================================================
# 前端环境变量模板
# ------------------------------------------------------------
# 用法：复制为 .env.local（该文件已被 .gitignore 忽略）
#     copy .env.example .env.local
#
# 不设置时的默认行为：请求走统一网关 http://localhost:9000
# ============================================================

# 后端统一入口地址。
#   - 走网关（阶段 1 起的默认形态）：http://localhost:9000
#   - 回退到直连单体（网关未启动时用这个）：http://localhost:8123
VITE_API_BASE=http://localhost:9000
