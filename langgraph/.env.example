# 复制为 langgraph/.env 后按需修改。
# .env 已被 .gitignore 忽略，密钥不会入库；本文件只是模板。

# ── 模型密钥（必填）──
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=

# ── Agent 主模型 ──
AGENT_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
LLM_TEMPERATURE=0.7

# ── Java 后端（8123）──
BACKEND_UPLOAD_URL=http://localhost:8123/api/upload/byToken
BACKEND_EDIT_URL=http://localhost:8123/api/edit/byToken
BACKEND_SEARCH_URL=http://localhost:8123/api/list/page/vo/cache
BACKEND_DELETE_URL=http://localhost:8123/api/delete
BACKEND_DELETE_BATCH_URL=http://localhost:8123/api/delete/batch
BACKEND_ALBUM_ADD_URL=http://localhost:8123/api/album/add
BACKEND_ALBUM_LIST_URL=http://localhost:8123/api/album/list/page/vo
BACKEND_ALBUM_PICTURE_ADD_URL=http://localhost:8123/api/album/picture/add
BACKEND_LOGIN_USER_URL=http://localhost:8123/api/user/get/login

# ── Qwen-VL 网关（8080）──
QWEN_IMAGE_API_URL=http://localhost:8080/chat/image
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ANALYZE_IMAGE_TIMEOUT=120

# ── 服务端口 ──
AGENT_API_PORT=8000
INDEX_API_PORT=8001
QWEN_API_PORT=8080

# ── 嵌入模型 ──
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu

# ── 知识库 ──
# RAG 只索引该目录下的 .txt 文件；默认 ../docs
# DOCS_DIR=

# ── 长期记忆 ──
MEMORY_AUTO_EXTRACT=true
MEMORY_EXTRACT_MIN_TURNS=3
MEMORY_EXTRACT_MIN_INTERVAL=300
MEMORY_EXTRACT_FORCE_TURNS=8
MEMORY_EXTRACT_WORKERS=1

# ── 会话侧存（图片 base64）容量控制 ──
MAX_IMAGES_PER_SESSION=6
SESSION_IDLE_TTL_SECONDS=1800

# ── 路径（默认都锚定在 langgraph/ 下，一般不用改）──
# CHROMA_PERSIST_DIR=data/chroma_rag_db
# CHROMA_PICTURE_DIR=data/chroma_picture_db
# CHROMA_MEMORY_DIR=data/chroma_memory_db
# STATIC_DIR=data/static
# LOG_DIR=data/logs
# FONT_PATH=C:/Windows/Fonts/simhei.ttf
